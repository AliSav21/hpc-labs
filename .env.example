# Скопіюй у .env і задай свій пароль: cp .env.example .env
POSTGRES_USER=donors
POSTGRES_PASSWORD=change-me
POSTGRES_DB=donors

# Кількість вебінстансів і порт балансувальника на хості
WEB_REPLICAS=1
# непоширений порт: 8080 часто вже зайнятий іншими програмами (див. README)
LB_PORT=18080
# Порт Prometheus на хості і розмір пулу зʼєднань (варіант 19)
PROM_PORT=19090
DB_POOL_SIZE=10

# Порти хоста кластера kind (ЛР3, ЛР4) — 8080 і 9090 з умови. 8080 на машині, де робилась
# робота, тримає служба NI Application Web Server; її треба зупинити (RUN-LAB3.md).
K8S_WEB_PORT=8080
K8S_PROM_PORT=9090
