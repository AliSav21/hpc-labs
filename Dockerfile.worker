# syntax=docker/dockerfile:1
# Воркер пула обробки (лабораторна робота 4). Власний образ: ні FastAPI, ні uvicorn,
# ні пулу зʼєднань сервісу web тут не потрібно.

FROM python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
COPY requirements-worker.txt .
RUN /opt/venv/bin/pip install -r requirements-worker.txt

FROM python:3.12-slim
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN useradd --system --uid 10002 --no-create-home worker
COPY --from=builder /opt/venv /opt/venv
WORKDIR /srv
COPY worker ./worker
USER 10002
# /metrics воркера і /metrics наглядача (крок 9)
EXPOSE 9100 9101
# exec-форма: SIGTERM отримує сам процес воркера, не оболонка
CMD ["python", "-m", "worker.entry"]
